# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# PostgreSQL Configuration
POSTGRES_USER=gtm_user
POSTGRES_PASSWORD=gtm_password
POSTGRES_DB=gtm_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL=postgresql+asyncpg://gtm_user:gtm_password@localhost:5432/gtm_intelligence
SYNC_DATABASE_URL=postgresql+psycopg://gtm_user:gtm_password@localhost:5432/gtm_intelligence

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (Optional for mock mode)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Worker & Provider Settings
DEFAULT_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=60
